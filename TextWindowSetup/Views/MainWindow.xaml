<Window x:Class="AutoCadAPI_demo.HotelRoomManager.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoCadAPI_demo.HotelRoomManager.View"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel Margin="20">
        <TextBlock Text="Hotel Room Manager" 
                   FontSize="18"
                   Margin="0,0,0,10"/>

        <Button Content="Load Rooms" Height="30" Margin="0,0,0,10"/>
        <Button Content="Book Room" Height="30"/>
    </StackPanel>
</Window>
